rules_version = '2';

// ===============================================================
// Assumed Data Model (KHADMA — Oran V1.4 Server-Authoritative Cutover)
// ===============================================================
//
// ALL client-side writes are denied across every collection. All
// mutations are executed server-side via Cloud Functions (Admin SDK):
// manageEmployerListing, adminManageMarketplace, reportGigListing,
// getGigContactLink, and scheduled expiration jobs.
//
// Collection: gigs (publicly readable when status == 'active' and not
//   expired on get, or by verified employer owner / verified admin; NO PII)
// Document ID: auto-generated
// Fields:
//   - title: string (3..120 chars)
//   - description: string (0..2000 chars)
//   - category: string (enum of 7 canonical categories)
//   - listingType: string ('job' | 'service')
//   - city: string ('oran')
//   - wilayaCode: string ('31')
//   - contactMethods: list<string> (['whatsapp' | 'email'])
//   - payMin: int (0..100000000)
//   - payMax: int (payMin..100000000)
//   - neighborhood: string (enum of 8 canonical Oran neighborhoods)
//   - posterUid: string (Firebase Auth UID or 'sample', immutable)
//   - flags: int (server-managed report count)
//   - status: string ('pending' | 'active' | 'archived' | 'expired' | 'hidden' | 'removed')
//   - verified: bool
//   - isSample: bool
//   - createdAt: timestamp (immutable)
//   - updatedAt: timestamp
//   - expiresAt: timestamp (enforced on public get; omitted on legacy V1.3 docs)
//   - moderationReason: string (optional)
//
// Collection: gigContacts (private PII — verified admin read only; Admin SDK write only)
// Document ID: {gigId} (1:1 with /gigs/{gigId})
// Fields:
//   - posterPhone: string (optional, E.164)
//   - posterEmail: string (optional)
//   - counterId: string (optional, legacy E.164)
//   - posterUid: string
//   - createdAt: timestamp
//
// Collection: employers (UID-based employer profile & quotas — owner or admin read; Admin SDK write only)
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - uid: string
//   - email: string (optional)
//   - legacyPhone: string (optional, E.164)
//   - maxActiveGigs: int (default 3 new, 5 legacy phone)
//   - activeCount: int (atomic count of active/pending gigs)
//   - trustLevel: string
//   - suspended: bool
//   - defaultContactMethods: list<string> (optional)
//   - createdAt / updatedAt: timestamp
//
// Collection: settings (runtime marketplace configuration — verified admin read only; Admin SDK write only)
// Document ID: {docId} (e.g. 'marketplace')
// Fields:
//   - requirePreApproval: bool
//   - remoderateMaterialEditsWhenEnabled: bool
//   - updatedAt: timestamp
//   - updatedBy: string
//
// Collection: auditLogs (server-written moderation & lifecycle audit trail — verified admin read only; Admin SDK write only)
// Document ID: auto-generated
// Fields:
//   - actorUid: string
//   - actorRole: string
//   - action: string
//   - targetType: string
//   - targetId: string
//   - metadata: map (optional)
//   - createdAt: timestamp
//
// Collection: phoneCounters (legacy V1.3 phone quota counters — phone owner or admin read; Admin SDK write only)
// Document ID: E.164 phone number (e.g. +213555123456)
// Fields:
//   - count: int (0..5)
//
// Collection: reports (abuse reports — verified admin read only; Admin SDK write only)
// Document ID: {gigId}_{reporterUid}
// Fields:
//   - gigId: string
//   - reason: string (enum of 5 report reasons)
//   - reporterId: string
//   - createdAt: timestamp
//
// Collection: contactRateLimits (server-only — all client access denied)
// Collection: reportRateLimits (server-only — all client access denied)
// Collection: listingIdempotency (server-only — all client access denied)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'cherouri@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isPhoneUser() {
      return signedIn() && request.auth.token.phone_number != null;
    }

    function isVerifiedEmployer() {
      return (signedIn() && request.auth.token.email_verified == true)
        || isPhoneUser();
    }

    // ===============================================================
    // Collection Rules (100% Server-Authoritative Writes)
    // ===============================================================

    match /gigs/{gigId} {
      // Public get enforces active status and non-expiration (allowing legacy V1.3 docs
      // without expiresAt); verified employer owners and verified admin may read all
      // lifecycle states (pending, active, archived, expired, hidden, removed).
      // Private contact PII is NOT stored here — it lives exclusively in /gigContacts/{gigId}.
      allow get: if (resource.data.status == 'active'
          && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time))
        || isAdmin()
        || (isVerifiedEmployer()
            && request.auth.uid != 'sample'
            && resource.data.posterUid == request.auth.uid);

      // Public list preserves active browse query (where('status', '==', 'active'));
      // server-side expiration transitions expired ads to status 'expired'.
      allow list: if resource.data.status == 'active'
        || isAdmin()
        || (isVerifiedEmployer()
            && request.auth.uid != 'sample'
            && resource.data.posterUid == request.auth.uid);

      // V1.4 cutover: ALL listing creation and mutations go strictly through
      // manageEmployerListing / adminManageMarketplace / reportGigListing (Admin SDK).
      allow create, update, delete: if false;
    }

    match /gigContacts/{gigId} {
      // Private contact PII. NEVER publicly readable; Cloud Functions read/write via Admin SDK.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /employers/{uid} {
      // UID-based employer quota, trustLevel, suspension, and default contact preferences.
      // Readable only by the owning user or verified admin; writable exclusively via Admin SDK.
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /settings/{docId} {
      // Runtime marketplace moderation settings (e.g., settings/marketplace).
      // Readable only by verified admin; writable exclusively via Admin SDK.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      // Server-written moderation and lifecycle audit trail.
      // Readable only by verified admin; writable exclusively via Admin SDK.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /phoneCounters/{phone} {
      // Legacy V1.3 phone quota counters preserved for backward compatibility.
      // Readable only by the matching phone-verified user or verified admin; Admin SDK write only.
      allow read: if (isPhoneUser() && phone == request.auth.token.phone_number) || isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      // Reports are created and managed exclusively by Cloud Functions Admin SDK.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /contactRateLimits/{limitId} {
      // Server-only rate-limiting buckets managed exclusively by Cloud Functions Admin SDK.
      allow read, write: if false;
    }

    match /reportRateLimits/{limitId} {
      // Server-only IP report rate-limiting buckets managed exclusively by Cloud Functions Admin SDK.
      allow read, write: if false;
    }

    match /listingIdempotency/{idemId} {
      // Server-only idempotency keys managed exclusively by Cloud Functions Admin SDK.
      allow read, write: if false;
    }

    // Explicit default deny for any unmatched collections or subcollections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
