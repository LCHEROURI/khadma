rules_version = '2';

// ===============================================================
// KHADMA V1.4 FINAL CUTOVER SECURITY RULES (POST-ROLLOUT HARDENED)
// ===============================================================
// Deploy ONLY after V1.4 Cloud Functions + Hosting are live and cached
// V1.3 PWAs have updated. Denies ALL direct client writes to gigs,
// gigContacts, employers, settings, auditLogs, reports, rate limits,
// and listingIdempotency (100% server-authoritative via Admin SDK).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'cherouri@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isPhoneUser() {
      return signedIn() && request.auth.token.phone_number != null;
    }

    function isVerifiedEmployer() {
      return (signedIn() && request.auth.token.email_verified == true)
        || isPhoneUser();
    }

    match /gigs/{gigId} {
      allow get: if (resource.data.status == 'active'
          && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time))
        || isAdmin()
        || (isVerifiedEmployer()
            && request.auth.uid != 'sample'
            && resource.data.posterUid == request.auth.uid);

      allow list: if resource.data.status == 'active'
        || isAdmin()
        || (isVerifiedEmployer()
            && request.auth.uid != 'sample'
            && resource.data.posterUid == request.auth.uid);

      // Final cutover: ALL listing creation and mutations go strictly through
      // manageEmployerListing / adminManageMarketplace (Admin SDK).
      allow create, update, delete: if false;
    }

    match /gigContacts/{gigId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /employers/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /phoneCounters/{phone} {
      allow read: if (isPhoneUser() && phone == request.auth.token.phone_number) || isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /contactRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /reportRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /listingIdempotency/{idemId} {
      allow read, write: if false;
    }
  }
}
