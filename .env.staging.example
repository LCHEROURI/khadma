# KHADMA Isolated Staging Web Configuration Template (copy to .env.staging.local — NEVER commit secrets)
# Populate ONLY after Phase 6B authorization creates the isolated staging project `khadma-oran-staging`.
# Retrieve values from:
#   firebase apps:sdkconfig web <STAGING_WEB_APP_ID> --project khadma-oran-staging
VITE_FIREBASE_ENV=staging
VITE_FIREBASE_PROJECT_ID=khadma-oran-staging
VITE_FIREBASE_AUTH_DOMAIN=khadma-oran-staging.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=khadma-oran-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
# Separate reCAPTCHA Enterprise site key registered exclusively for khadma-oran-staging:
VITE_RECAPTCHA_SITE_KEY=
